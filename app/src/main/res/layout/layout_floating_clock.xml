<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗布局：三档尺寸复用同一布局，由 OverlayController 控制各行可见性
    小：仅 tv_time
    中：tv_time（含十分位）+ tv_offset + tv_network
    大：同上，但字号最大

  tv_countdown 是例外：它由「是否启用倒计时」决定，不受尺寸档位限制——
  倒计时是用户主动开启的，开了就该看得见。

  action_bar 是单击悬浮窗后展开的操作面板：尺寸 / 打开 / 关闭。
  它之所以画在窗口内部而不是用 PopupWindow，是为了不引入第二个窗口——
  悬浮窗本身是 TYPE_APPLICATION_OVERLAY，再叠一层子窗口会让触摸分发和层级管理复杂化。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp"
    android:background="@drawable/bg_overlay_clock">

    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:text="00:00:00.0"
        android:textColor="@color/overlay_text_time"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:textColor="@color/overlay_text_time"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="距开票 00:04:59.2" />

    <TextView
        android:id="@+id/tv_offset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:text="@string/overlay_status_syncing"
        android:textColor="@color/overlay_text_offset"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tv_network"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:textColor="@color/overlay_text_offset"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="↓128K/s ↑12K/s"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/action_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_overlay_action"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/overlay_action_size"
            android:textColor="@color/overlay_text_offset"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/action_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_overlay_action"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/overlay_action_app"
            android:textColor="@color/overlay_text_offset"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/action_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_overlay_action"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/overlay_action_close"
            android:textColor="@color/status_failed"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏小图标：单色矢量，系统会自动染色 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- 表盘 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:pathData="M12,3.2 A8.8,8.8 0 1,0 12,20.8 A8.8,8.8 0 1,0 12,3.2 Z" />

    <!-- 指针：12 点与 4 点方向，体现时间刻度 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M12,7.2 L12,12 L15.6,15" />

    <!-- 中心轴点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,10.6 A1.4,1.4 0 1,0 12,13.4 A1.4,1.4 0 1,0 12,10.6 Z" />

</vector>
